# Separate full external-font/committed-cache board qualification profile.
# 32 MHz SYS / requested X3 VID. No native Z identity or timing acceptance.
source sharpx1_turbo_video.qsf
set_global_assignment -name VERILOG_MACRO "X1_TURBO_Z_EXTERNAL_FONT=1"
# Scaler input/HDMI/Avalon resets each release on two local edges. No raw
# scaler reset-pin exception is selected until a fresh fit is inventoried.
set_global_assignment -name VERILOG_MACRO "X1_SCALER_LOCAL_RESET_RELEASE=1"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
# Same SYS32 coherent dimensions payload as the qualified Z timing experiment.
# Bound only held_data -> destination_data; other CDC/HDMI paths stay timed.
set_global_assignment -name SDC_FILE sharpx1_turbo_z_font.sdc
# Async assertion inputs only. Stage transfer and release fanout stay timed.
# This revision has no palette release pipeline; require exactly its two pins.
set_global_assignment -name SDC_FILE sharpx1_turbo_z_font_reset.sdc
