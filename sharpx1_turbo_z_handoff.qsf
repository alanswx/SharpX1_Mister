# Separate full-board HDMI handoff qualification; NOT hardware/timing accepted.
# Preserve existing board revisions. Match Z/X3 features, replacing only its
# old raw-mux clock constraint; raw CDC and data-path violations stay visible.
source sharpx1_turbo_video.qsf
set_global_assignment -name VERILOG_MACRO "X1_TURBO_Z_VIDEO_EXPERIMENT=1"
set_global_assignment -name VERILOG_MACRO "X1_HDMI_HANDOFF_EXPERIMENT=1"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
set_global_assignment -name SDC_FILE sharpx1_turbo_z_video.sdc
set_global_assignment -name SDC_FILE scripts/constraints/pcg_response_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/pcg_request_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/video_reset_input_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/scaler_reset_input_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/hdmi_handoff_mux_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/vsync_sys_input_candidate.sdc
