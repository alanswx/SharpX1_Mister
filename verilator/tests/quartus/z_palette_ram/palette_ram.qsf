# Standalone inference/fit probe, NOT a MiSTer board project or pinout.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY x1_z_palette_ram
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE x1_z_palette_ram.sv
set_global_assignment -name SDC_FILE palette_ram.sdc
# Keep every data/control port observable without assigning board pins.
# Clock pins are left to the fitter; this is not a board clock assignment.
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_reset
set_instance_assignment -name VIRTUAL_PIN ON -to video_reset
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_access
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_write
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_component[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_nibble[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_valid
set_instance_assignment -name VIRTUAL_PIN ON -to display_read
set_instance_assignment -name VIRTUAL_PIN ON -to display_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to display_rgb12[*]
set_instance_assignment -name VIRTUAL_PIN ON -to display_valid
