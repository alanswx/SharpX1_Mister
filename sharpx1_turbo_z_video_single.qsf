# Single-clock X3 Z video board qualification profile: combined palette,
# multi-mode, internal-8 and text composition on one X3 PLL master
# (fitted 42,954,545.45 Hz) with enables. Not native Z firmware, ASIC timing,
# DAC or release acceptance. The two-clock sharpx1_turbo_z_video is frozen.
source sharpx1_turbo_video.qsf
set_global_assignment -name VERILOG_MACRO "X1_SINGLE_CLOCK=1"
set_global_assignment -name VERILOG_MACRO "X1_TURBO_Z_VIDEO_EXPERIMENT=1"
# Framework parity only: the X3 master takes stock CLK_VIDEO's clock groups.
# None of the two-clock Z video SDC candidates or payload bounds are used.
set_global_assignment -name SDC_FILE scripts/constraints/x3_single_clock_groups.sdc
