# Experimental combined palette/multimode/text composition FPGA qualification.
# Not native Turbo Z firmware, ASIC timing, physical DAC or release acceptance.
# Inherits independent 32 MHz SYS and requested X3 VID; DMA/SIO/FM/Kanji off.
source sharpx1_turbo_video.qsf
set_global_assignment -name VERILOG_MACRO "X1_TURBO_Z_VIDEO_EXPERIMENT=1"
set_global_assignment -name SDC_FILE sharpx1_turbo_z_video.sdc
set_global_assignment -name SDC_FILE scripts/constraints/pcg_response_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/pcg_request_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/video_reset_input_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/scaler_reset_input_candidate.sdc
set_global_assignment -name SDC_FILE scripts/constraints/hdmi_mux_candidate.sdc
